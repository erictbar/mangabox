{
	"name": "mangabox",
	"version": "0.3.1",
	"author": "zpaolo11x paolo.zago@gmail.com",
	"description": "Desktop client for Komga server",
	"main": "package-main.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-builder"
	},
	"dependencies": {
		"@capacitor/android": "^7.0.0",
		"@capacitor/camera": "^7.0.2",
		"@capacitor/core": "^7.0.0",
		"@capacitor/filesystem": "^7.1.4",
		"@capacitor/ios": "^7.0.0",
		"@capacitor/status-bar": "^7.0.3",
		"@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
		"@capawesome/capacitor-file-picker": "^7.2.0",
		"@ethion/capacitor-navigation-bar": "^7.0.6",
		"keytar": "^7.9.0",
		"node-stream-zip": "^1.15.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.0.0",
		"electron": "^38.2.0",
		"electron-builder": "^26.0.12"
	},
	"build": {
		"appId": "com.zpaolo11x.mangabox",
		"productName": "MangaBox",
		"asarUnpack": [
			"**/node_modules/keytar/**"
		],
		"directories": {
			"output": "dist"
		},
		"files": [
			"**/*",
			"!z_*/**/*",
			"!z_*.*",
			"!stores/**/*",
			"!docs/**/*",
			"!docs_old/**/*",
			"!capacitor*",
			"package-main.js",
			"package-preload.js",
			"package.json"
		],
		"mac": {
			"target": "dir",
			"artifactName": "MangaBox-${version}-macOS-${arch}",
			"icon": "build/icons/mangabox.icns",
			"category": "public.app-category.utilities"
		},
		"dmg": {
			"artifactName": "MangaBox-${version}-macOS-${arch}.dmg",
			"icon": "assets/icons/dmg_icon.icns",
			"background": "assets/dmg-background.tiff"
		},
		"win": {
			"target": "portable",
			"artifactName": "MangaBox-${version}-Windows-${arch}.exe",
			"icon": "build/icons/mangabox.ico"
		},
		"linux": {
			"target": "AppImage",
			"artifactName": "MangaBox-${version}-Linux-${arch}.AppImage",
			"icon": "assets/icons/mangabox.png"
		}
	}
}
